# ============================================================
#  CLIPPER — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
# Required for Whisper transcription + niche detection embeddings
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Whisper model to use: whisper-1 (only model available via API)
OPENAI_WHISPER_MODEL=whisper-1

# Embedding model for niche detection
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama (Local AI) ─────────────────────────────────────────
# If you don't have an OpenAI key, you can use local Ollama models.
# Make sure Ollama is running (`ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b

# ── Server ───────────────────────────────────────────────────
# Port the Express backend will listen on
PORT=3001

# CORS allowed origin (your Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# ── File Upload ──────────────────────────────────────────────
# Max video file size in megabytes
MAX_UPLOAD_MB=500

# Temp directory for uploaded/processed videos (relative to server/)
UPLOAD_DIR=uploads

# Output directory for processed clips
OUTPUT_DIR=output

# ── FFmpeg ───────────────────────────────────────────────────
# Absolute path to FFmpeg binary — leave blank to use system PATH
# e.g. /opt/homebrew/bin/ffmpeg
FFMPEG_PATH=

# ── Subtitle Defaults ────────────────────────────────────────
# Default language for Whisper transcription (ISO-639-1)
# e.g. en, id, ja, zh
SUBTITLE_DEFAULT_LANG=en

# ── Optional: AssemblyAI (alternative transcription) ─────────
# If you prefer AssemblyAI over OpenAI Whisper uncomment & fill
# ASSEMBLYAI_API_KEY=

# ── Optional: Supabase (file storage / auth) ──────────────────
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ── Optional: Redis (job queue for heavy processing) ──────────
# REDIS_URL=redis://localhost:6379
